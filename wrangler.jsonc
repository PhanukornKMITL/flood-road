{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flood-road",
  "main": "cloudflare/worker.mjs",
  "account_id": "6904db04d8512b3ef3e371fec100b956",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klaeng-road-reports",
      "database_id": "dd308dfa-3e88-4afa-abd1-978f6622cc06",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}